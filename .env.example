# Environment variables. Placeholders only; never commit .env.local.
# NEXT_PUBLIC_* values are public and baked in at build time (redeploy after
# changing). Everything else is server-only. Empty means unset.
# Restart `npm run dev` after edits. VERCEL_ENV is set by Vercel.
# The site origin and business details (address, phone, map) are in
# src/lib/site.ts, not here.
#
#   Variable                         Local        Vercel Production     Vercel Preview
#   NOTION_TOKEN                     required     required, Sensitive   required
#   NOTION_*_DATABASE_ID (5)         required     required              required
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY   test key     required              required
#   TURNSTILE_SECRET_KEY             test secret  required, Sensitive   required
#   BREVO_API_KEY                    send tests   required, Sensitive   optional
#   CONTACT_FROM_EMAIL               send tests   required              optional
#   CONTACT_NOTIFICATION_FROM_EMAIL  send tests   required              optional
#   CONTACT_TO_EMAIL                 send tests   required              optional
#   CONTACT_FROM_NAME                optional     optional              optional
#   CONTACT_NOTIFICATION_FROM_NAME   optional     optional              optional
#   CONTACT_CC_EMAIL                 optional     optional              optional
#   SITE_URL                         optional     unset                 unset
#
# The build reads Notion, so `npm run build` needs the Notion values.


# ---- Local (.env.local) -----------------------------------------------------

# Notion CMS: read-only integration token and database IDs.
NOTION_TOKEN=
NOTION_MENU_DATABASE_ID=
NOTION_HOURS_DATABASE_ID=
NOTION_ANNOUNCEMENTS_DATABASE_ID=
NOTION_PILLARS_DATABASE_ID=
NOTION_PLATFORMS_DATABASE_ID=

# Cloudflare Turnstile test keys (always pass). Real keys go in Vercel.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Contact form email (Brevo). Only for real send tests; mail goes to the real
# inbox. CONTACT_FROM_EMAIL sends the visitor's confirmation;
# CONTACT_NOTIFICATION_FROM_EMAIL sends the enquiry to CONTACT_TO_EMAIL.
BREVO_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_NOTIFICATION_FROM_EMAIL=
CONTACT_TO_EMAIL=
# Optional: sender names (default "VietBites") and a technical copy
# (default admin@motchi.ca).
CONTACT_FROM_NAME=
CONTACT_NOTIFICATION_FROM_NAME=
CONTACT_CC_EMAIL=

# Origin override, only for another local port.
SITE_URL=


# ---- Vercel Production (set in Vercel, not here) ---------------------------

# Cloudflare Turnstile: Managed widget listing the production and preview
# hostnames. The site key is public; the secret key is Sensitive.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=<site key>
# TURNSTILE_SECRET_KEY=<secret key>
# NOTION_TOKEN and BREVO_API_KEY are Sensitive in Vercel.
